<mxfile host="genroofs" type="device"><diagram id="fake_evidence" name="fake_evidence"><mxGraphModel dx="1000" dy="470" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="470" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="ROOF-304 · How a fake claim photo is made, and how an insurer catches it" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="960" height="30" as="geometry"/></mxCell><mxCell id="photo" value="&lt;b&gt;A roof photo&lt;/b&gt;&lt;br&gt;a real home&amp;#x27;s, or a house&lt;br&gt;an AI made up" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="55" width="210" height="90" as="geometry"/></mxCell><mxCell id="edit" value="&lt;b&gt;An AI edit (inpainting)&lt;/b&gt;&lt;br&gt;repaints one marked part: a tarp,&lt;br&gt;missing shingles, a fallen branch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="55" width="300" height="90" as="geometry"/></mxCell><mxCell id="claim" value="&lt;b&gt;A claim photo that looks real&lt;/b&gt;&lt;br&gt;made in seconds,&lt;br&gt;no storm and no camera needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="55" width="330" height="90" as="geometry"/></mxCell><mxCell id="checks" value="&lt;b&gt;Before paying, the insurer checks three things&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="185" width="960" height="44" as="geometry"/></mxCell><mxCell id="where" value="&lt;b&gt;Where and when was it taken?&lt;/b&gt;&lt;br&gt;camera, time, place, upload history;&lt;br&gt;Content Credentials (C2PA) record edits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="260" width="300" height="100" as="geometry"/></mxCell><mxCell id="compare" value="&lt;b&gt;Compare with independent records&lt;/b&gt;&lt;br&gt;public aerial photos of the same roof&lt;br&gt;before and after the storm; weather data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="260" width="300" height="100" as="geometry"/></mxCell><mxCell id="person" value="&lt;b&gt;A person decides&lt;/b&gt;&lt;br&gt;an inspector visits when the photo&lt;br&gt;and the records disagree" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="260" width="300" height="100" as="geometry"/></mxCell><mxCell id="rule" value="&lt;b&gt;Treat &amp;quot;AI-enhanced&amp;quot; photos as illustrations, not evidence: the edit takes seconds,&lt;/b&gt;&lt;br&gt;so the checks have to be routine." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="385" width="960" height="65" as="geometry"/></mxCell><mxCell id="e0" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=12;" edge="1" parent="1" source="photo" target="edit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=12;" edge="1" parent="1" source="edit" target="claim"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=12;" edge="1" parent="1" source="claim" target="checks"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
