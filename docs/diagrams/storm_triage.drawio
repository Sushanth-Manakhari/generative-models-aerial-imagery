<mxfile host="genroofs" type="device"><diagram id="storm_triage" name="storm_triage"><mxGraphModel dx="1000" dy="470" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="470" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="ROOF-305 · After the storm: from photos to an adjuster&#x27;s route, with a person deciding" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="960" height="30" as="geometry"/></mxCell><mxCell id="photos" value="&lt;b&gt;Photos after the storm&lt;/b&gt;&lt;br&gt;NOAA, flown the&lt;br&gt;next day" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="170" height="80" as="geometry"/></mxCell><mxCell id="model" value="&lt;b&gt;Damage model&lt;/b&gt;&lt;br&gt;a small network trained&lt;br&gt;with the GAN critic&amp;#x27;s loss" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="70" width="200" height="80" as="geometry"/></mxCell><mxCell id="labels" value="&lt;b&gt;Expert labels&lt;/b&gt;&lt;br&gt;here: FEMA&amp;#x27;s damage&lt;br&gt;levels; at work:&lt;br&gt;adjusters&amp;#x27; findings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="205" width="180" height="90" as="geometry"/></mxCell><mxCell id="queue" value="&lt;b&gt;Inspection queue&lt;/b&gt;&lt;br&gt;homes in order of&lt;br&gt;likely damage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="70" width="150" height="80" as="geometry"/></mxCell><mxCell id="town" value="&lt;b&gt;Damage per town&lt;/b&gt;&lt;br&gt;how many adjusters,&lt;br&gt;how much money" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="205" width="180" height="80" as="geometry"/></mxCell><mxCell id="adj" value="&lt;b&gt;An adjuster&lt;/b&gt;&lt;br&gt;visits and decides&lt;br&gt;the claim" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="70" width="150" height="80" as="geometry"/></mxCell><mxCell id="gov" value="&lt;b&gt;Before and during use: test on a storm and a region the model never saw · check mistakes by area ·&lt;/b&gt;&lt;br&gt;document the data, the model and every decision · a person decides each claim · measure again after every storm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="960" height="70" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;The model never pays, denies or prices a claim: it only decides the order of the work.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="415" width="960" height="40" as="geometry"/></mxCell><mxCell id="e0" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=12;" edge="1" parent="1" source="photos" target="model"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=12;" edge="1" parent="1" source="labels" target="model"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=12;" edge="1" parent="1" source="model" target="queue"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=12;" edge="1" parent="1" source="model" target="town"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=12;" edge="1" parent="1" source="queue" target="adj"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="new labels" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=12;dashed=1;" edge="1" parent="1" source="adj" target="labels"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
