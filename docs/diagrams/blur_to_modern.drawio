<mxfile host="genroofs" type="device"><diagram id="blur_to_modern" name="blur_to_modern"><mxGraphModel dx="1000" dy="470" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="470" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="From the classic models&#x27; drawbacks to today&#x27;s fixes" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="960" height="30" as="geometry"/></mxCell><mxCell id="aev" value="&lt;b&gt;Autoencoder and VAE: blur&lt;/b&gt;&lt;br&gt;the squeeze into 128 numbers, and a pixel score&lt;br&gt;that rewards a safe grey average" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="380" height="90" as="geometry"/></mxCell><mxCell id="gan" value="&lt;b&gt;GAN: sharp but strange&lt;/b&gt;&lt;br&gt;no pixel score, so crisp edges; too little&lt;br&gt;training to learn what a house is" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="380" height="90" as="geometry"/></mxCell><mxCell id="vae2" value="&lt;b&gt;Better autoencoders  (slide)&lt;/b&gt;&lt;br&gt;memory as a small grid, a &amp;quot;looks real&amp;quot; score,&lt;br&gt;millions of photos: Stable Diffusion&amp;#x27;s autoencoder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="50" width="420" height="90" as="geometry"/></mxCell><mxCell id="sr" value="&lt;b&gt;Enlargers  (live in class)&lt;/b&gt;&lt;br&gt;Real-ESRGAN (a GAN) and SwinIR (a Swin&lt;br&gt;Transformer) sharpen what is still in the picture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="160" width="420" height="90" as="geometry"/></mxCell><mxCell id="diff" value="&lt;b&gt;Diffusion models  (slide)&lt;/b&gt;&lt;br&gt;Stable Diffusion v1.5 draws convincing new roofs,&lt;br&gt;but not in our photos&amp;#x27; style" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="270" width="420" height="90" as="geometry"/></mxCell><mxCell id="warn" value="&lt;b&gt;Sharp is not the same as true: enlargers and redraws add believable detail, not real detail.&lt;/b&gt;&lt;br&gt;For an insurer, an &amp;quot;AI-enhanced&amp;quot; photo can show what was never there." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="385" width="960" height="70" as="geometry"/></mxCell><mxCell id="e0" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=12;" edge="1" parent="1" source="aev" target="vae2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=12;" edge="1" parent="1" source="aev" target="sr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=12;" edge="1" parent="1" source="gan" target="diff"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
