<mxfile host="genroofs" type="device"><diagram id="pc_uses" name="pc_uses"><mxGraphModel dx="1000" dy="470" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="470" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Where generative models fit in a property and casualty (P&amp;C) insurer" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="960" height="30" as="geometry"/></mxCell><mxCell id="uw" value="&lt;b&gt;Underwriting&lt;/b&gt;&lt;br&gt;quoting and renewing&lt;br&gt;a home policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="180" height="75" as="geometry"/></mxCell><mxCell id="dq" value="&lt;b&gt;Image quality&lt;/b&gt;&lt;br&gt;every photo a model&lt;br&gt;will read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="215" y="60" width="180" height="75" as="geometry"/></mxCell><mxCell id="cat" value="&lt;b&gt;After a storm&lt;/b&gt;&lt;br&gt;thousands of claims&lt;br&gt;in a few days" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="60" width="180" height="75" as="geometry"/></mxCell><mxCell id="cl" value="&lt;b&gt;Claims&lt;/b&gt;&lt;br&gt;photos sent in by&lt;br&gt;policyholders" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="605" y="60" width="180" height="75" as="geometry"/></mxCell><mxCell id="data" value="&lt;b&gt;Testing new systems&lt;/b&gt;&lt;br&gt;without customer&lt;br&gt;data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="60" width="180" height="75" as="geometry"/></mxCell><mxCell id="uw2" value="&lt;b&gt;Autoencoder&lt;/b&gt;&lt;br&gt;flags unusual roofs for&lt;br&gt;an inspection&lt;br&gt;(ROOF-301)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="180" height="95" as="geometry"/></mxCell><mxCell id="dq2" value="&lt;b&gt;Autoencoder&lt;/b&gt;&lt;br&gt;catches empty lots,&lt;br&gt;clouds, bad crops&lt;br&gt;(ROOF-301)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="215" y="180" width="180" height="95" as="geometry"/></mxCell><mxCell id="cat2" value="&lt;b&gt;A damage model on&lt;/b&gt;&lt;br&gt;expert labels ranks&lt;br&gt;homes; damage per town&lt;br&gt;(ROOF-305)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="180" width="180" height="95" as="geometry"/></mxCell><mxCell id="cl2" value="&lt;b&gt;Photo checks&lt;/b&gt;&lt;br&gt;compare with aerial&lt;br&gt;photos before and after&lt;br&gt;(ROOF-304)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="605" y="180" width="180" height="95" as="geometry"/></mxCell><mxCell id="data2" value="&lt;b&gt;VAE and GAN&lt;/b&gt;&lt;br&gt;roofs that belong&lt;br&gt;to nobody&lt;br&gt;(ROOF-302, ROOF-303)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="180" width="180" height="95" as="geometry"/></mxCell><mxCell id="risk" value="&lt;b&gt;The same models can harm: unfair flags in places unlike the training photos, scores a homeowner never sees,&lt;/b&gt;&lt;br&gt;and convincing fake damage photos (ROOF-304)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="310" width="960" height="60" as="geometry"/></mxCell><mxCell id="gov" value="&lt;b&gt;A person decides; the model only orders the work. Test for errors and unfair outcomes, document,&lt;/b&gt;&lt;br&gt;and keep monitoring (NAIC Model Bulletin on insurers&amp;#x27; use of AI, December 2023)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="390" width="960" height="60" as="geometry"/></mxCell><mxCell id="e0" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=12;" edge="1" parent="1" source="uw" target="uw2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=12;" edge="1" parent="1" source="dq" target="dq2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=12;" edge="1" parent="1" source="cat" target="cat2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=12;" edge="1" parent="1" source="cl" target="cl2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=12;" edge="1" parent="1" source="data" target="data2"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
